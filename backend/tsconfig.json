{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    // "rootDir": ".",
    "outDir": "./dist",
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*",
        "tests/*"
      ]
    },
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "experimentalDecorators": true,
    "emitDecoratorMetadata": true,
  },
  "include": [
    "src/**/*",
    "drizzle.config.ts",
    "drizzle/**/*",
    "tests/**/*",
    "jest.config.js",
  ],
  "exclude": [
    "node_modules",
    "dist",
    "test",
    "**/*spec.ts"
  ]
}
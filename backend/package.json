{
    "name": "backend",
    "version": "1.0.0",
    "license": "MIT",
    "scripts": {
        "dev": "ts-node-dev --respawn --transpile-only -r tsconfig-paths/register src/main.ts",
        "build": "tsc -p tsconfig.json && tsc-alias",
        "start": "node ./dist/main.js",
        "lint": "eslint .",
        "lint:fix": "eslint . --fix",
        "format": "prettier . --write",
        "format:check": "prettier . --check",
        "drizzle:generate": "npx drizzle-kit generate",
        "drizzle:migrate": "npx drizzle-kit migrate",
        "test": "jest",
        "test:watch": "jest --watch"
    },
    "dependencies": {
        "@fastify/compress": "^8.3.1",
        "@fastify/cookie": "^11.0.2",
        "@fastify/cors": "^11.2.0",
        "@fastify/env": "^5.0.3",
        "@fastify/helmet": "^13.0.2",
        "@fastify/jwt": "^10.0.0",
        "bcryptjs": "^3.0.3",
        "dotenv": "^17.2.4",
        "drizzle-orm": "^0.45.1",
        "fastify": "^5.7.4",
        "fastify-type-provider-zod": "^6.1.0",
        "jsonwebtoken": "^9.0.3",
        "pg": "^8.18.0",
        "pino": "^10.3.1",
        "pino-pretty": "^13.1.3",
        "reflect-metadata": "^0.2.2",
        "tsyringe": "^4.10.0",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.3",
        "@eslint/js": "^10.0.1",
        "@faker-js/faker": "^10.3.0",
        "@types/jest": "^30.0.0",
        "@types/jsonwebtoken": "^9.0.10",
        "@types/node": "^25.2.3",
        "@types/pg": "^8.16.0",
        "@typescript-eslint/eslint-plugin": "^8.55.0",
        "@typescript-eslint/parser": "^8.55.0",
        "drizzle-kit": "^0.31.9",
        "eslint": "^10.0.0",
        "eslint-config-prettier": "^10.1.8",
        "eslint-plugin-prettier": "^5.5.5",
        "jest": "^30.2.0",
        "prettier": "^3.8.1",
        "ts-jest": "^29.4.6",
        "ts-node-dev": "^2.0.0",
        "tsc-alias": "^1.8.16",
        "tsconfig-paths": "^4.2.0",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3",
        "typescript-eslint": "^8.55.0"
    }
}
